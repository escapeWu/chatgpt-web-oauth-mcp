CHATGPT_MCP_HOST=127.0.0.1
CHATGPT_MCP_PORT=8766
CHATGPT_MCP_WORKSPACE_ROOT=/absolute/path/to/workspace
CHATGPT_MCP_STATE_DIR=~/.chatgpt-web-oauth-mcp
CHATGPT_MCP_AUTH_TOKEN=replace-me
# For ChatGPT web OAuth mode:
# CHATGPT_MCP_AUTH_MODE=oauth
# CHATGPT_MCP_PUBLIC_BASE_URL=https://your-public-mcp-host.example
# CHATGPT_MCP_OAUTH_LOGIN_TOKEN=
# CHATGPT_MCP_OAUTH_SCOPES=local-ops
# CHATGPT_MCP_OAUTH_TOKEN_TTL_SECONDS=86400
CHATGPT_MCP_CLOUDFLARED_CONFIG=
CHATGPT_MCP_TUNNEL_NAME=
# Set to 1 when an existing cloudflared service already maps your public host to this MCP server.
CHATGPT_MCP_EXTERNAL_CLOUDFLARED=0
CHATGPT_MCP_CODEX_COMMAND=codex
CHATGPT_MCP_CODEX_RUNTIME_DEFAULT_SANDBOX=workspace-write
CHATGPT_MCP_CODEX_RUNTIME_MAX_CONCURRENCY=4
CHATGPT_MCP_CODEX_RUNTIME_MAX_RUNTIMES=64
CHATGPT_MCP_CODEX_RUNTIME_STARTUP_TIMEOUT_SECONDS=15
CHATGPT_MCP_CODEX_RUNTIME_DEFAULT_TIMEOUT_MS=120000
CHATGPT_MCP_CODEX_RUNTIME_MAX_TIMEOUT_MS=300000
CHATGPT_MCP_CODEX_RUNTIME_OUTPUT_MAX_BYTES=1048576
CHATGPT_MCP_CODEX_RUNTIME_MAX_MESSAGE_BYTES=8388608
CHATGPT_MCP_PI_COMMAND=pi
CHATGPT_MCP_DELEGATE_DEFAULT_HARNESS=codex
CHATGPT_MCP_COMMAND_TIMEOUT=120
CHATGPT_MCP_DELEGATE_TIMEOUT=300
CHATGPT_MCP_DELEGATE_WAIT_TIMEOUT=300
CHATGPT_MCP_DELEGATE_EXPLORE_EXECUTION_TIMEOUT=900
CHATGPT_MCP_DELEGATE_CODE_EXECUTION_TIMEOUT=3600
CHATGPT_MCP_DELEGATE_CANCEL_GRACE_SECONDS=5
CHATGPT_MCP_DELEGATE_EXPLORE_MAX_PER_PROJECT=4
CHATGPT_MCP_DELEGATE_EXPLORE_MAX_GLOBAL=8
CHATGPT_MCP_DELEGATE_CODE_MAX_PER_PROJECT=1
CHATGPT_MCP_DELEGATE_CODE_MAX_GLOBAL=4
CHATGPT_MCP_DELEGATE_QUEUE_LIMIT_PER_PROJECT=32
CHATGPT_MCP_DELEGATE_QUEUE_LIMIT_GLOBAL=128
CHATGPT_MCP_TMUX_BINARY=tmux
CHATGPT_MCP_TMUX_SOCKET_NAME=default
CHATGPT_MCP_TMUX_CONTROL_TIMEOUT=10
CHATGPT_MCP_DEBUG_MCP_LOGGING=0
CHATGPT_MCP_GRACEFUL_SHUTDOWN_SECONDS=30
CHATGPT_MCP_WATCHDOG_INTERVAL_SECONDS=60
CHATGPT_MCP_DOCTOR_FAILURE_THRESHOLD=3
CHATGPT_MCP_DOCTOR_BASE_BACKOFF_SECONDS=300
CHATGPT_MCP_DOCTOR_MAX_BACKOFF_SECONDS=3600
CHATGPT_MCP_LAUNCHD_LABEL_PREFIX=com.chatgpt-web-oauth-mcp
